        "codeExecution": "Execute user-written function body with input parameter in sandbox",
        "inputAccess": "User can access input properties like: input.user, input.email, input.data, etc."
      }
    },

    "COMBINE": {
      "category": "FLOW",
      "inherits": "Uses FLOW category UI layout and execution pattern",
      "purpose": "Merge multiple inputs into single output",

      "handles": {
        "inputs": {
          "count": "Multiple, dynamic",
          "userControl": "User can add/remove input handles",
          "defaultIds": ["in1", "in2"],
          "schema": {
            "editable": true,
            "defaultType": "any",
            "canInferSchema": true
          }
        },
        "outputs": {
          "count": 1,
          "fixed": true,
          "id": "out",
          "label": "Output",
          "schema": {
            "editable": true,
            "defaultType": "any",
            "canInferSchema": true,
            "derivedFrom": "Combined from all input types"
          }
        }
      },

      "ui": {
        "leftPanel": {
          "content": "List of input handles (dynamic)",
          "components": [
            "For each input handle:",
            "  - Handle display with label",
            "  - Schema indicator",
            "+ Add Input button",
            "- Remove Input button (for each handle)",
            "Infer Schema button (at bottom)"
          ]
        },
        "centerPanel": {
          "tabs": [
            {
              "id": "combine",
              "label": "Combine Logic",
              "fields": [
                {
                  "id": "strategy",
                  "type": "select",
                  "label": "Combine Strategy",
                  "options": ["mergeObjects", "concatArrays", "custom"],
                  "default": "mergeObjects",
                  "required": true,
                  "descriptions": {
                    "mergeObjects": "Merge all inputs as objects: { ...in1, ...in2, ...in3 }",
                    "concatArrays": "Concatenate all inputs as arrays: [...in1, ...in2, ...in3]",
                    "custom": "Write custom code to combine inputs"
                  }
                },
                {
                  "id": "customCode",
                  "type": "code",
                  "label": "Custom Combine Code",
                  "language": "javascript",
                  "required": false,
                  "showWhen": "strategy === 'custom'",
                  "placeholder": "// Access inputs as: inputs.in1, inputs.in2, etc.\nreturn { combined: { ...inputs.in1, ...inputs.in2 } };",
                  "note": "inputs object contains all input handle data"
                },
                {
                  "id": "waitForAll",
                  "type": "boolean",
                  "label": "Wait for All Inputs",
                  "default": true,
                  "description": "If true, waits for all inputs to have data. If false, combines available inputs only."
                }
              ]
            }
          ]
        },
        "rightPanel": {
          "content": "Single output handle",
          "components": [
            "Output handle display",
            "Schema indicator",
            "Infer Schema button (at bottom)"
          ]
        }
      },

      "execution": {
        "logic": "Collect data from all input handles, apply combine strategy, output result",
        "steps": [
          "1. Get data from all input handles",
          "2. If waitForAll=true: check all inputs have data, else skip empty inputs",
          "3. Apply combine strategy:",
          "   - mergeObjects: spread merge { ...in1, ...in2, ... }",
          "   - concatArrays: array concat [...in1, ...in2, ...]",
          "   - custom: execute user's custom code",
          "4. Output combined result to 'out' handle"
        ],
        "typeHandling": {
          "mergeObjects": "All inputs must be objects, output is object",
          "concatArrays": "All inputs must be arrays, output is array",
          "custom": "User controls type logic"
        },
        "pseudocode": [
          "async function executeCombine(inputs, config) {",
          "  // Step 1: Collect input data",
          "  const inputData = {};",
          "  for (const handleId in inputs) {",
          "    inputData[handleId] = inputs[handleId];",
          "  }",
          "",
          "  // Step 2: Check if all inputs present (if required)",
          "  if (config.waitForAll) {",
          "    const expectedHandles = config.inputHandles; // ['in1', 'in2', ...]",
          "    for (const handle of expectedHandles) {",
          "      if (!inputData[handle] || inputData[handle].length === 0) {",
          "        throw new Error(`Missing data for input: ${handle}`);",
          "      }",
          "    }",
          "  }",
          "",
          "  // Step 3: Apply combine strategy",
          "  let result;",
          "  switch (config.strategy) {",
          "    case 'mergeObjects':",
          "      result = Object.assign({}, ...Object.values(inputData));",
          "      break;",
          "    case 'concatArrays':",
          "      result = [].concat(...Object.values(inputData));",
          "      break;",
          "    case 'custom':",
          "      result = executeCustomCode(config.customCode, inputData);",
          "      break;",
          "  }",
          "",
          "  // Step 4: Output",
          "  return { out: [result] };",
          "}"
        ]
      }
    },

    "CONDITION": {
      "category": "FLOW",
      "inherits": "Uses FLOW category UI layout and execution pattern",
      "purpose": "Route input to multiple outputs based on conditions",

      "handles": {
        "inputs": {
          "count": 1,
          "fixed": true,
          "id": "in",
          "label": "Input",
          "schema": {
            "editable": true,
            "defaultType": "any",
            "canInferSchema": true
          }
        },
        "outputs": {
          "count": "Multiple, dynamic",
          "userControl": "User can add/remove output handles",
          "defaultOutputs": [
            { "id": "out1", "label": "Output 1", "condition": "input.value > 0" },
            { "id": "out2", "label": "Output 2", "condition": "input.value <= 0" }
          ],
          "schema": {
            "editable": true,
            "defaultType": "any",
            "canInferSchema": true,
            "derivedFrom": "Same as input type"
          }
        }
      },

      "ui": {
        "leftPanel": {
          "content": "Single input handle",
          "components": [
            "Input handle display",
            "Schema indicator",
            "Infer Schema button (at bottom)"
          ]
        },
        "centerPanel": {
          "tabs": [
            {
              "id": "conditions",
              "label": "Conditions",
              "content": "List of outputs with their conditions",
              "structure": [
                "For each output:",
                {
                  "outputLabel": {
                    "type": "string",
                    "label": "Output Label",
                    "placeholder": "Output 1"
                  },
                  "condition": {
                    "type": "code",
                    "language": "javascript",
                    "label": "Condition",
                    "placeholder": "input.age > 18",
                    "note": "Return true to route to this output. Input available as 'input' variable."
                  }
                },
                "+ Add Output button",
                "- Remove Output button (for each)"
              ],
              "note": "Input can match multiple conditions and go to multiple outputs"
            }
          ]
        },
        "rightPanel": {
          "content": "Output handles selector",
          "components": [
            "Output selector dropdown (choose which output to view)",
            "Selected output handle display",
            "Schema indicator",
            "Infer Schema button (at bottom)"
          ]
        }
      },

      "execution": {
        "logic": "Evaluate all conditions, route input to all matching outputs",
        "steps": [
          "1. Get input data",
          "2. For each output:",
          "   - Evaluate its condition with input data",
          "   - If condition returns true, add input to that output's results",
          "3. Route data to all matching outputs",
          "4. Note: Input can go to multiple outputs (non-exclusive)"
        ],
        "conditionEvaluation": "Each condition is JavaScript expression/code that receives 'input' and returns boolean",
        "pseudocode": [
          "async function executeCondition(inputs, config) {",
          "  // Step 1: Get input data",
          "  const inputData = inputs.in[0]; // Single input, first item",
          "",
          "  // Step 2: Evaluate conditions",
          "  const outputs = {};",
          "  for (const output of config.outputs) {",
          "    const conditionResult = evaluateCondition(output.condition, inputData);",
          "    ",
          "    if (conditionResult === true) {",
          "      outputs[output.id] = [inputData]; // Route to this output",
          "    }",
          "  }",
          "",
          "  // Step 3: Return routed outputs",
          "  return outputs;",
          "}"
        ],
        "typeHandling": "All output types are same as input type"
      }
    },

    "IF": {
      "category": "FLOW",
      "inherits": "Uses FLOW category UI layout and execution pattern",
      "purpose": "Binary routing based on single condition",
      "note": "Special case of CONDITION node with exactly 2 outputs and opposite conditions",

      "handles": {
        "inputs": {
          "count": 1,
          "fixed": true,
          "id": "in",
          "label": "Input",
          "schema": {
            "editable": true,
            "defaultType": "any",
            "canInferSchema": true
          }
        },
        "outputs": {
          "count": 2,
          "fixed": true,
          "outputs": [
            { "id": "true", "label": "True" },
            { "id": "false", "label": "False" }
          ],
          "schema": {
            "editable": true,
            "defaultType": "any",
            "canInferSchema": true,
            "derivedFrom": "Same as input type"
          }
        }
      },

      "ui": {
        "leftPanel": {
          "content": "Single input handle",
          "components": [
            "Input handle display",
            "Schema indicator",
            "Infer Schema button (at bottom)"
          ]
        },
        "centerPanel": {
          "tabs": [
            {
              "id": "condition",
              "label": "Condition",
              "fields": [
                {
                  "id": "condition",
                  "type": "code",
                  "language": "javascript",
                  "label": "IF Condition",
                  "required": true,
                  "placeholder": "input.age >= 18",
                  "note": "Return true/false. Input available as 'input' variable."
                }
              ]
            }
          ]
        },
        "rightPanel": {
          "content": "Toggle between true/false output",
          "components": [
            "Toggle: True | False",
            "Show selected output handle",
            "Schema indicator",
            "Infer Schema button (at bottom)"
          ]
        }
      },

      "execution": {
        "logic": "Evaluate single condition, route to true OR false output",
        "steps": [
          "1. Get input data",
          "2. Evaluate condition",
          "3. If condition is true → route to 'true' output",
          "4. If condition is false → route to 'false' output",
          "5. Always routes to exactly ONE output"
        ],
        "conditionEvaluation": "Single JavaScript expression/code that receives 'input' and returns boolean",
        "pseudocode": [
          "async function executeIf(inputs, config) {",
          "  // Step 1: Get input data",
          "  const inputData = inputs.in[0]; // Single input, first item",
          "",
          "  // Step 2: Evaluate condition",
          "  const conditionResult = evaluateCondition(config.condition, inputData);",
          "",
          "  // Step 3: Route to appropriate output",
          "  if (conditionResult === true) {",
          "    return { true: [inputData], false: [] };",
          "  } else {",
          "    return { true: [], false: [inputData] };",
          "  }",
          "}"
        ],
        "typeHandling": "Both outputs have same type as input"
      }
