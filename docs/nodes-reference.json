          ]
        },
        "centerPanel": {
          "tabs": [
            {
              "id": "switch",
              "label": "Switch Logic",
              "fields": [
                {
                  "id": "switchExpression",
                  "type": "string",
                  "label": "Switch Expression",
                  "required": true,
                  "placeholder": "input.status",
                  "note": "JavaScript expression to evaluate (e.g., input.status, input.type, input.code)"
                }
              ],
              "cases": [
                "For each case:",
                {
                  "caseValue": {
                    "type": "string",
                    "label": "Case Value",
