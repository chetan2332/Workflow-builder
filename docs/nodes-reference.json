    "FUNCTION": {
      "category": "CODE",
      "inherits": "Uses CODE category handles, UI layout, and execution flow",
      "specificBehavior": {
        "centerTabs": [
          {
            "id": "code",
            "label": "Code",
            "fields": [
              {
                "id": "language",
                "type": "select",
                "label": "Language",
                "options": ["javascript", "python"],
                "default": "javascript"
              },
              {
                "id": "code",
                "type": "code",
                "label": "Function Code",
                "language": "Matches language field",
                "required": true,
                "prewrittenCode": "function(input) {\n  // Your code here\n}",
                "editableSection": "function body only",
                "unchangeableSection": "function(input) {} wrapper is fixed",
                "placeholder": "// Access input data like:\n// input.user\n// input.email\n// input.data\n\nreturn { result: input.value * 2 };",
                "note": "Only function body is editable. Wrapper 'function(input) {}' is prewritten and unchangeable."
              }
            ]
