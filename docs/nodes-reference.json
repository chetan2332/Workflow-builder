            { "id": "case2", "label": "Case 2", "value": "approved" },
            { "id": "default", "label": "Default", "isDefault": true }
          ],
          "schema": {
            "editable": true,
            "defaultType": "any",
            "canInferSchema": true,
            "derivedFrom": "Same as input type"
          }
        }
      },

      "ui": {
        "leftPanel": {
          "content": "Single input handle",
          "components": [
            "Input handle display",
