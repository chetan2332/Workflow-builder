            "id": "request",
            "label": "Request",
            "fields": [
              {
                "id": "method",
                "type": "select",
                "label": "Method",
                "options": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
                "default": "GET",
                "required": true
              },
              {
                "id": "url",
                "type": "string",
                "label": "URL",
                "required": true,
                "placeholder": "https://api.example.com/endpoint",
                "supportsInputInterpolation": true,
                "note": "Can use input values like: https://api.example.com/users/{{input.userId}}"
              },
              {
                "id": "headers",
                "type": "keyValue",
                "label": "Headers",
                "required": false,
                "supportsInputInterpolation": true,
                "note": "Can use input values in header values"
              },
              {
                "id": "body",
                "type": "json",
                "label": "Body",
                "required": false,
                "showWhen": "method !== 'GET'",
                "supportsInputInterpolation": true,
                "note": "Can use input values in body fields"
              },
              {
                "id": "outputParser",
                "type": "string",
                "label": "Output Parser",
                "required": false,
                "placeholder": "res.d.result[0]",
                "description": "JavaScript expression to extract data from response (e.g., res.data.items[0])"
              }
            ]
          },
          {
            "id": "auth",
            "label": "Authentication",
            "fields": [
              {
                "id": "authType",
                "type": "select",
                "label": "Auth Type",
                "options": ["none", "basic", "bearer", "apikey"],
                "default": "none"
              },
              {
                "id": "credentialRef",
                "type": "credentialRef",
                "label": "Credential",
                "showWhen": "authType !== 'none'"
              }
            ]
          },
          {
            "id": "schema",
            "label": "Schema",
            "note": "Mandatory schema tab - last position"
          }
        ],
        "codeExecution": "Make HTTP request with interpolated values, apply output parser if provided"
      }
    },

