{
  "nodeCategories": {
    "TRIGGER": {
      "description": "All TRIGGER nodes follow this pattern",

      "ui": {
        "layout": "three-column",
        "leftPanel": {
          "title": "Sample Payload",
          "fields": [
            {
              "id": "samplePayload",
              "type": "json",
              "label": "Sample Payload",
              "required": false,
              "placeholder": "{}",
              "description": "Test data for manual workflow runs"
            }
          ]
        },
        "centerPanel": {
          "title": "Input Schema",
          "description": "Define the structure of expected input data",
          "component": "SchemaBuilder",
          "schemaField": "inputSchema"
        },
        "rightPanel": {
          "title": "Output",
          "description": "Full right side for single output handle",
          "showOutputHandle": true,
          "handleConfig": {
            "id": "out",
            "label": "Output",
            "hasType": true,
            "defaultType": "any",
            "typeEditable": true,
            "note": "Every handle is associated with a type (default: 'any'). This type will be used for validation."
          }
        }
      },

      "execution": {
        "logic": "Pass-through: Take input and pass to output as-is",
        "steps": [
          "1. Get samplePayload from config",
          "2. Parse if string (JSON.parse)",
          "3. Optional: Validate against inputSchema if enforceSchema is true",
          "4. Output to 'out' handle without modification"
        ],
        "pseudocode": "output['out'] = [samplePayload]"
      },

      "notes": [
        "All TRIGGER nodes use this same UI and execution pattern",
        "Can be extended later if specific trigger nodes need different behavior"
      ]
    },

    "CODE": {
      "description": "All CODE nodes follow this pattern - HTTP, LLM, FUNCTION",

      "handles": {
        "structure": "Fixed - user has NO control",
        "input": {
          "count": 1,
          "id": "in",
          "label": "Input",
          "schema": {
            "defaultType": "any",
            "editable": true,
            "canInferSchema": true
          }
        },
        "outputs": [
          {
            "id": "success",
            "label": "Success",
            "schema": {
              "defaultType": "any",
              "editable": true,
              "canInferSchema": true
            }
          },
          {
            "id": "error",
            "label": "Error",
            "schema": {
              "fixed": true,
              "editable": false,
              "structure": {
                "type": "object",
                "properties": [
                  { "name": "error", "schema": { "type": "boolean", "required": true } },
                  { "name": "message", "schema": { "type": "string", "required": true } },
                  { "name": "code", "schema": { "type": "string", "required": false } },
                  { "name": "stack", "schema": { "type": "string", "required": false } }
                ]
              }
            }
          }
        ],
        "note": "2 output handles but only 1 shown at a time in UI (toggle between success/error view)"
      },

      "ui": {
        "layout": "three-column",
        "leftPanel": {
          "title": "Input",
          "content": "Shows input handle only",
          "components": [
            "InputHandle display",
            "Infer Schema button (at bottom)"
          ]
        },
        "centerPanel": {
          "title": "Configuration",
          "content": "Tabbed interface with node-specific tabs",
          "tabs": [
            "Node-specific tabs (varies by node)",
            {
              "id": "schema",
              "label": "Schema",
              "position": "always last",
              "required": true,
              "description": "This tab is mandatory for all CODE nodes"
            }
          ]
        },
        "rightPanel": {
          "title": "Output",
          "content": "Shows ONE output handle at a time",
          "components": [
            "Toggle/Select: Success or Error view",
            "OutputHandle display (based on selection)",
            "Infer Schema button (at bottom) - only for success handle"
          ],
          "note": "Error handle schema is fixed, success handle schema is editable"
        }
      },

      "execution": {
        "generalizedFlow": "Input validation → Execute some code → Output validation → Route to handle",
        "steps": [
          "1. Get input data from 'in' handle",
          "2. VALIDATE: Input data against input handle schema (if schema defined)",
          "3. EXECUTE: Run some code (node-specific implementation)",
          "4. VALIDATE: Output data against success handle schema (if schema defined)",
          "5. ROUTE: If all steps succeed → 'success' handle, else → 'error' handle"
        ],
        "errorHandling": {
          "inputValidationFails": "→ error handle with validation error details",
          "codeExecutionFails": "→ error handle with execution error details",
          "outputValidationFails": "→ error handle with validation error details"
        },
        "pseudocode": [
          "async function executeCodeNode(input, config, schemas) {",
          "  try {",
          "    // Step 1: Validate input",
          "    if (schemas.input) {",
          "      const validation = validateData(input, schemas.input);",
          "      if (!validation.valid) throw new ValidationError(validation.errors);",
          "    }",
          "",
          "    // Step 2: Execute some code (node-specific)",
          "    const result = await executeSomeCode(config, input);",
          "",
          "    // Step 3: Validate output",
          "    if (schemas.success) {",
          "      const validation = validateData(result, schemas.success);",
          "      if (!validation.valid) throw new ValidationError(validation.errors);",
          "    }",
          "",
          "    // Step 4: Route to success",
          "    return { success: [result], error: [] };",
          "",
          "  } catch (error) {",
          "    // Route to error handle with fixed error schema",
          "    return {",
          "      success: [],",
          "      error: [{",
          "        error: true,",
          "        message: error.message,",
          "        code: error.code || 'EXECUTION_ERROR',",
          "        stack: error.stack",
          "      }]",
          "    };",
          "  }",
          "}"
        ]
      },

      "notes": [
        "All CODE nodes (HTTP, LLM, FUNCTION) follow this generalized pattern",
        "Only difference is what 'some code' does - defined in each node's specificBehavior",
        "Execution always: validate input → execute → validate output → route"
      ]
    },

    "FLOW": {
      "description": "All FLOW nodes follow this pattern - COMBINE, CONDITION, IF, SWITCH",

      "purpose": "Data routing and flow control - no external execution, just routing logic",

      "characteristics": [
        "No API calls or external code execution",
        "All about routing data from input(s) to output(s)",
        "Logic-based decisions (conditions, value matching, merge strategies)",
        "Type preservation (output types derive from input types)",
        "Synchronous execution (no async operations)"
      ],

      "ui": {
        "layout": "three-column",
        "leftPanel": {
          "title": "Inputs",
          "content": "Shows input handle(s)",
          "capabilities": [
            "Display input handles",
            "Dynamic add/remove inputs (for COMBINE node)",
            "Infer Schema button (at bottom)"
          ]
        },
        "centerPanel": {
          "title": "Logic Configuration",
          "content": "Node-specific routing/condition logic",
          "note": "Varies by node - see each node's specificBehavior"
        },
        "rightPanel": {
          "title": "Outputs",
          "content": "Shows output handle(s)",
          "capabilities": [
            "Display output handles",
            "Dynamic add/remove outputs (for CONDITION, SWITCH nodes)",
            "Toggle/Selector for viewing specific output",
            "Infer Schema button (at bottom)"
          ]
        }
      },

      "execution": {
        "generalizedFlow": "Get input data → Apply routing logic → Route to outputs",
        "steps": [
          "1. Get input data (from single or multiple input handles)",
          "2. Apply node-specific routing logic",
          "3. Route data to appropriate output handle(s)",
          "4. No validation - data passes through as-is"
        ],
        "pseudocode": [
          "async function executeFlowNode(inputs, config) {",
          "  // Step 1: Get input data",
          "  const inputData = getInputData(inputs);",
          "",
          "  // Step 2: Apply node-specific routing logic",
          "  const routingDecisions = applyRoutingLogic(inputData, config);",
          "",
          "  // Step 3: Route to outputs",
          "  const outputs = {};",
          "  for (const [handleId, data] of routingDecisions) {",
          "    outputs[handleId] = data;",
          "  }",
          "",
          "  return outputs;",
          "}"
        ],
        "typeHandling": "Output types are derived from input types (no transformation)"
      },

      "notes": [
        "All FLOW nodes (COMBINE, CONDITION, IF, SWITCH) follow this generalized pattern",
        "No external execution - purely data routing",
        "Synchronous and fast execution"
      ]
    }
  },

  "nodes": {
    "START": {
      "category": "TRIGGER",
      "inherits": "Uses TRIGGER category UI and execution pattern",
      "specificBehavior": "None - uses default TRIGGER behavior"
    },

    "HTTP": {
      "category": "CODE",
      "inherits": "Uses CODE category handles, UI layout, and execution flow",
      "specificBehavior": {
        "centerTabs": [
