                  },
                  "outputLabel": {
                    "type": "string",
                    "label": "Output Label",
                    "placeholder": "Pending"
                  }
                },
                "+ Add Case button",
                "- Remove Case button (for each)"
              ],
              "defaultCase": [
                {
                  "id": "enableDefault",
                  "type": "boolean",
                  "label": "Enable Default Case",
                  "default": true,
                  "note": "If enabled, unmatched inputs go to default output. If disabled, unmatched inputs produce no output."
                }
              ]
            }
          ]
        },
        "rightPanel": {
          "content": "Output handles selector",
          "components": [
            "Output selector dropdown (choose which output to view)",
            "Selected output handle display",
            "Schema indicator",
            "Infer Schema button (at bottom)"
          ]
        }
      },

      "execution": {
        "logic": "Evaluate switch expression, match value to cases, route to matching output",
        "steps": [
          "1. Get input data",
          "2. Evaluate switch expression (e.g., input.status → 'pending')",
          "3. Find case that matches the expression result",
          "4. Route to matching case output",
          "5. If no match:",
          "   - If default case enabled → route to default output",
          "   - If default case disabled → no output (or error)",
          "6. Always routes to exactly ONE output"
        ],
        "switchEvaluation": "Switch expression is JavaScript code that returns a value to match against case values",
        "pseudocode": [
          "async function executeSwitch(inputs, config) {",
          "  // Step 1: Get input data",
          "  const inputData = inputs.in[0]; // Single input, first item",
          "",
          "  // Step 2: Evaluate switch expression",
          "  const switchValue = evaluateExpression(config.switchExpression, inputData);",
          "",
          "  // Step 3: Find matching case",
          "  let matchedOutput = null;",
          "  for (const caseConfig of config.cases) {",
          "    if (caseConfig.value === switchValue) {",
          "      matchedOutput = caseConfig.outputId;",
          "      break;",
          "    }",
          "  }",
          "",
          "  // Step 4: Handle default case",
          "  if (!matchedOutput && config.enableDefault) {",
          "    matchedOutput = 'default';",
          "  }",
          "",
          "  // Step 5: Route to output",
          "  const outputs = {};",
          "  if (matchedOutput) {",
          "    outputs[matchedOutput] = [inputData];",
          "  }",
          "",
          "  return outputs;",
          "}"
        ],
        "typeHandling": "All outputs have same type as input"
      }
    }
