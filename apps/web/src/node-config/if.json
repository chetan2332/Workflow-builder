{
  "nodeId": "IF",
  "name": "If",
  "nodeType": "CONDITION",
  "description": "Branch based on a condition.",
  "shape": "circle",
  "dynamicHandles": {
    "inputs": true,
    "outputs": false
  },
  "handles": [
    {
      "id": "in-1",
      "side": "left",
      "kind": "input",
      "type": "any",
      "label": "in"
    },
    {
      "id": "out-true",
      "side": "right",
      "kind": "output",
      "type": "flow",
      "label": "true"
    },
    {
      "id": "out-false",
      "side": "right",
      "kind": "output",
      "type": "flow",
      "label": "false"
    }
  ],
  "action": {
    "title": "Configure If",
    "description": "Set number of inputs and condition code.",
    "tabs": ["handles", "logic"],
    "fields": [
      {
        "id": "inputHandleCount",
        "label": "Number of inputs",
        "type": "handleCount",
        "defaultValue": 1,
        "min": 1,
        "tab": "handles"
      },
      {
        "id": "inputHandleType",
        "label": "Input handle type",
        "type": "handleTypes",
        "defaultValue": "json",
        "tab": "handles"
      },
      {
        "id": "code",
        "label": "Condition code",
        "type": "code",
        "language": "javascript",
        "placeholder": "return inputs[0].value > 10;",
        "tab": "logic"
      }
    ]
  }
}

