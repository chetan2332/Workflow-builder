{
  "nodeId": "FUNCTION",
  "name": "Function",
  "nodeType": "CODE",
  "description": "Run a custom function.",
  "shape": "roundedRectangle",
  "dynamicHandles": {
    "inputs": true,
    "outputs": false
  },
  "handles": [
    {
      "id": "in-1",
      "side": "left",
      "kind": "input",
      "type": "any",
      "label": "in"
    },
    {
      "id": "out",
      "side": "right",
      "kind": "output",
      "type": "json",
      "label": "out"
    }
  ],
  "action": {
    "title": "Configure Function",
    "description": "Set number of inputs and function code.",
    "tabs": ["handles", "logic"],
    "fields": [
      {
        "id": "inputHandleCount",
        "label": "Number of inputs",
        "type": "handleCount",
        "defaultValue": 1,
        "min": 1,
        "tab": "handles"
      },
      {
        "id": "language",
        "label": "Language",
        "type": "enum",
        "options": [
          { "value": "javascript", "label": "JavaScript" },
          { "value": "python", "label": "Python" }
        ],
        "defaultValue": "javascript",
        "tab": "logic"
      },
      {
        "id": "code",
        "label": "Function code",
        "type": "code",
        "language": "javascript",
        "placeholder": "return { result: inputs[0] };",
        "tab": "logic"
      }
    ]
  }
}

