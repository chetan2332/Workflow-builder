{
  "nodeId": "LLM",
  "name": "LLM",
  "nodeType": "CODE",
  "description": "Calls a configured model with credentials; returns completion text.",
  "shape": "rectangleWithText",
  "handles": [
    {
      "id": "in",
      "side": "left",
      "kind": "input",
      "type": "json",
      "label": "in"
    },
    {
      "id": "out",
      "side": "right",
      "kind": "output",
      "type": "json",
      "label": "out"
    }
  ],
  "action": {
    "title": "Configure LLM",
    "description": "Select model, set prompts, and configure parameters.",
    "fields": [
      {
        "id": "modelId",
        "label": "Model",
        "type": "modelRef",
        "required": true
      },
      {
        "id": "credentialRef",
        "label": "Credential",
        "type": "credentialRef",
        "required": true
      },
      {
        "id": "inlineText",
        "label": "Display text",
        "type": "inlineText",
        "placeholder": "LLM",
        "defaultValue": "LLM"
      },
      {
        "id": "systemPrompt",
        "label": "System prompt",
        "type": "text",
        "placeholder": "You are a helpful assistant..."
      },
      {
        "id": "prompt",
        "label": "User prompt",
        "type": "text",
        "required": true,
        "placeholder": "Enter your prompt here..."
      },
      {
        "id": "temperature",
        "label": "Temperature",
        "type": "number",
        "defaultValue": 0.7,
        "min": 0,
        "max": 2
      },
      {
        "id": "maxTokens",
        "label": "Max tokens",
        "type": "number",
        "defaultValue": 1000
      }
    ]
  }
}
