{
  "nodeId": "SWITCH",
  "name": "Switch",
  "nodeType": "CONDITION",
  "description": "Branch based on multiple cases.",
  "shape": "circle",
  "dynamicHandles": {
    "inputs": true,
    "outputs": true
  },
  "handles": [
    {
      "id": "in-1",
      "side": "left",
      "kind": "input",
      "type": "any",
      "label": "in"
    },
    {
      "id": "out-1",
      "side": "right",
      "kind": "output",
      "type": "flow",
      "label": "case 1"
    }
  ],
  "action": {
    "title": "Configure Switch",
    "description": "Set number of inputs, outputs and switch code.",
    "tabs": ["handles", "logic"],
    "fields": [
      {
        "id": "inputHandleCount",
        "label": "Number of inputs",
        "type": "handleCount",
        "defaultValue": 1,
        "min": 1,
        "tab": "handles"
      },
      {
        "id": "outputHandleCount",
        "label": "Number of outputs",
        "type": "handleCount",
        "defaultValue": 2,
        "min": 1,
        "tab": "handles"
      },
      {
        "id": "outputLabels",
        "label": "Output labels",
        "type": "handleLabels",
        "placeholder": "case 1, case 2, case 3",
        "tab": "handles"
      },
      {
        "id": "inputHandleType",
        "label": "Input handle type",
        "type": "handleTypes",
        "defaultValue": "json",
        "tab": "handles"
      },
      {
        "id": "outputHandleType",
        "label": "Output handle type",
        "type": "handleTypes",
        "defaultValue": "flow",
        "tab": "handles"
      },
      {
        "id": "code",
        "label": "Switch expression",
        "type": "code",
        "language": "javascript",
        "placeholder": "return 0; // return case index",
        "tab": "logic"
      }
    ]
  }
}

