// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum NodeType {
  TRIGGER
  CODE
  CONDITION
  OTHER
}

enum NodeShape {
  CIRCLE
  OPPOSITE_D
  ROUNDED_RECTANGLE
  RECTANGLE_WITH_TEXT
}

model NodeTemplate {
  id          String   @id @default(cuid())

  // Template identity
  templateId  String   // "HTTP", "LLM", "IF", "SWITCH" - semantic ID
  version     String   @default("1.0.0") // Version for breaking changes
  name        String   // "HTTP Request", "LLM", "If/Else"
  description String?

  // Visual properties
  nodeType    NodeType
  shape       NodeShape

  // Handle configuration (static definition)
  handlesConfig Json   // Array of HandleConfig from JSON files

  // Action configuration (fields definition)
  actionConfig Json?   // NodeActionConfig from JSON files

  // Dynamic handles support
  dynamicHandles Json? // { inputs: boolean, outputs: boolean }

  // Metadata
  isActive    Boolean  @default(true)  // Can be deactivated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  nodes       Node[]

  @@unique([templateId, version]) // Allow multiple versions
  @@index([templateId, isActive])
  @@index([nodeType])
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)

  nodes Node[]
  edges Edge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

model Node {
  id         String   @id  // Client-provided (nanoid) for stability
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Template reference
  templateId      String
  templateVersion String  @default("1.0.0")
  template        NodeTemplate @relation(fields: [templateId, templateVersion], references: [templateId, version])

  // Instance-specific data
  label       String?
  positionX   Float
  positionY   Float
  actionState Json @default("{}")  // User configuration

  // optional back-relations to edges (nice to have)
  outgoingEdges Edge[] @relation("EdgeSource")
  incomingEdges Edge[] @relation("EdgeTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([templateId, templateVersion])
}

model Edge {
  id String @id  // Client-provided (nanoid) for stability

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  sourceNodeId String
  targetNodeId String

  sourceNode Node @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode Node @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  sourceHandle String?
  targetHandle String?

  // extra metadata if needed later
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}
