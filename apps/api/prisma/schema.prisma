// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum NodeType {
  TRIGGER
  CODE
  CONDITION
  OTHER
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)

  nodes Node[]
  edges Edge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Node {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  type  NodeType
  label String?

  positionX Float
  positionY Float

  // arbitrary config, including code, settings, etc.
  config Json

  // optional back-relations to edges (nice to have)
  outgoingEdges Edge[] @relation("EdgeSource")
  incomingEdges Edge[] @relation("EdgeTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Edge {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  sourceNodeId String
  targetNodeId String

  sourceNode Node @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode Node @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  sourceHandle String?
  targetHandle String?

  // extra metadata if needed later
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
