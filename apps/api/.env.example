# Database
# Local: postgresql://user:password@localhost:5432/dbname
# Docker: postgresql://user:password@host.docker.internal:5432/dbname
# RDS: postgresql://user:password@<rds-endpoint>:5432/dbname
DATABASE_URL="postgresql://admin:admin123@localhost:5432/automation_workflow_db?schema=public"

# App
NODE_ENV=development
PORT=3000

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Execution engine URL
# Local: http://localhost:3001
# EC2:   http://<engine-ec2-ip>:3001
EXECUTION_ENGINE_URL=http://localhost:3001

# Cognito / JWT
# COGNITO_USER_POOL_ID=us-east-1_xxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxx
# COGNITO_REGION=us-east-1
